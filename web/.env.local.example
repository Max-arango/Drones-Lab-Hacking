# Supabase — copy this file to .env.local and fill in real values.
#
# The publishable key (sb_publishable_*) is the new format. Prefer it
# over the legacy anon JWT (eyJ...) — it supports independent rotation
# and is what Supabase recommends for new client integrations.
#
# Get both from: https://supabase.com/dashboard/project/<ref>/settings/api
#
# NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<your-key>
